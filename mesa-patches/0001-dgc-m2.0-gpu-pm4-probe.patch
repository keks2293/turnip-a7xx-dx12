+    * отделяет «память обновилась после барьера (SP видит)» от «CP/PFE
+    * видит устаревшее». */
+   struct tu_shader *dgc_probe_verify_shader;
+
    uint32_t vsc_draw_strm_pitch;
    uint32_t vsc_prim_strm_pitch;
