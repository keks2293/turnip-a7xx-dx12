0007: TU_FORCE_PROPS - force driver properties from an environment
variable.

Relations: none - touches only diagnostics, does not affect format
lists.

diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 3c904bf3d70..07f36d2c44d 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -15,6 +15,8 @@
 
 #include "common/freedreno_stompable_regs.h"
 /* for fd_get_driver/device_uuid() */
+#include <stdlib.h>
+#include <string.h>
 #include "util/cache_ops.h"
 #include "util/disk_cache.h"
 #include "util/driconf.h"
@@ -1679,6 +1681,103 @@ static const VkQueueFamilyProperties tu_sparse_queue_family_properties = {
    .minImageTransferGranularity = { 1, 1, 1 },
 };
 
+/**
+ * TU_FORCE_PROPS - forcibly raises the boolean fd6_gpu_info flags that are
+ * missing from the device table.
+ *
+ * Why: the values in freedreno_devices.py are observations of the Qualcomm
+ * blob for a specific chip, not a generational split. So it is unknown
+ * whether our chip supports what is only declared for a neighbour (e.g. a750
+ * in a7xx_gen3 has load_shader_consts_via_preamble and has_generic_clear,
+ * while our a740 in a7xx_gen2 does not). The override lets one test such a
+ * hypothesis with a single rebuild instead of one rebuild per flag.
+ *
+ * The value is a comma-separated list of names; unknown names are reported
+ * in the log. Everything that applied is printed too, so the log shows that
+ * the flag was actually taken into account rather than silently ignored.
+ *
+ * TU_MAX_DRAW_STATES is handled separately: it is a number, not a flag.
+ *
+ * IMPORTANT: the override is not validated by anything. A wrong flag causes
+ * visual corruption or a GPU hang. Correctness is verified by the tests
+ * (scripts/run-test.sh), not by this code.
+ */
+static void
+tu_force_props(struct fd_dev_info *info)
+{
+   const char *mds = getenv("TU_MAX_DRAW_STATES");
+   if (mds) {
+      info->props.max_draw_states = strtoul(mds, NULL, 0);
+      mesa_logi("TU_MAX_DRAW_STATES: max_draw_states = %u",
+                info->props.max_draw_states);
+   }
+
+   const char *force = getenv("TU_FORCE_PROPS");
+   if (!force)
+      return;
+
+   struct {
+      const char *name;
+      bool *val;
+   } flags[] = {
+      { "load_shader_consts_via_preamble",
+        &info->props.load_shader_consts_via_preamble },
+      { "load_inline_uniforms_via_preamble_ldgk",
+        &info->props.load_inline_uniforms_via_preamble_ldgk },
+      { "has_generic_clear", &info->props.has_generic_clear },
+      { "has_gmem_vpc_attr_buf", &info->props.has_gmem_vpc_attr_buf },
+      { "ubwc_all_formats_compatible",
+        &info->props.ubwc_all_formats_compatible },
+      { "has_compliant_dp4acc", &info->props.has_compliant_dp4acc },
+      { "has_persistent_counter", &info->props.has_persistent_counter },
+      { "has_abs_bin_mask", &info->props.has_abs_bin_mask },
+      { "ubwc_coherency_quirk", &info->props.ubwc_coherency_quirk },
+      { "cs_lock_unlock_quirk", &info->props.cs_lock_unlock_quirk },
+      { "enable_tp_ubwc_flag_hint",
+        &info->props.enable_tp_ubwc_flag_hint },
+      { "r8g8_faulty_fast_clear_quirk",
+        &info->props.r8g8_faulty_fast_clear_quirk },
+   };
+
+   char *buf = strdup(force);
+   if (!buf)
+      return;
+
+   for (char *item = strtok(buf, ","); item; item = strtok(NULL, ",")) {
+      bool found = false;
+
+      for (unsigned i = 0; i < ARRAY_SIZE(flags); i++) {
+         if (strcmp(item, flags[i].name))
+            continue;
+
+         *flags[i].val = true;
+
+         /* VPC in GMEM without buffer sizes is useless: the cache is not
+          * allocated, while accesses go by a zero size. We substitute the
+          * a750 (a7xx_gen3) values if not set explicitly, and say so.
+          */
+         if (!strcmp(item, "has_gmem_vpc_attr_buf")) {
+            if (!info->props.sysmem_vpc_attr_buf_size)
+               info->props.sysmem_vpc_attr_buf_size = 0x20000;
+            if (!info->props.gmem_vpc_attr_buf_size)
+               info->props.gmem_vpc_attr_buf_size = 0xc000;
+            mesa_logi("TU_FORCE_PROPS: vpc_attr_buf_size sysmem=0x%x gmem=0x%x",
+                      info->props.sysmem_vpc_attr_buf_size,
+                      info->props.gmem_vpc_attr_buf_size);
+         }
+
+         mesa_logi("TU_FORCE_PROPS: %s", flags[i].name);
+         found = true;
+         break;
+      }
+
+      if (!found)
+         mesa_logw("TU_FORCE_PROPS: unknown flag '%s'", item);
+   }
+
+   free(buf);
+}
+
 VkResult
 tu_physical_device_init(struct tu_physical_device *device,
                         struct tu_instance *instance)
@@ -1693,9 +1792,11 @@ tu_physical_device_init(struct tu_physical_device *device,
                                device->dev_id.chip_id, device->dev_id.gpu_id);
    }
 
-   const struct fd_dev_info info = fd_dev_info(&device->dev_id);
+   struct fd_dev_info info = fd_dev_info(&device->dev_id);
    assert(info.chip);
 
+   tu_force_props(&info);
+
    /* Print a suffix if raytracing is disabled by the SW fuse, in an attempt
     * to avoid confusion when apps don't work.
     */
