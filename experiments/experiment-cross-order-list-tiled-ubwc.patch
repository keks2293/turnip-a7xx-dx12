+/* EXPERIMENT (mixed-swap): every format of the list is the very same texel
+ * block - same channel count, bits and block shape - so the list disagrees
+ * only about which channel the bytes mean (B8G8R8A8 together with R8G8B8A8,
+ * say) and not about where the bytes live.  Such a list is exactly what
+ * tu6_format_list_swaps_are_uniform() rejects while remaining one layout as
+ * far as the block geometry goes; tu_image_init() keeps tiled+UBWC for it
+ * and lets the S3 probe decide whether the views read back correctly.
+ */
+bool
+tu6_format_list_same_shape(const VkImageFormatListCreateInfo *fmt_list)
+{
+   if (!fmt_list || fmt_list->viewFormatCount < 2)
+      return false;
+
+   VkFormat first_vk_format = fmt_list->pViewFormats[0];
+   if (vk_format_is_depth_or_stencil(first_vk_format) ||
+       vk_format_is_compressed(first_vk_format) ||
+       vk_format_get_plane_count(first_vk_format) > 1)
+      return false;
+   const struct util_format_description *first =
+      util_format_description(vk_format_to_pipe_format(first_vk_format));
+
+   for (uint32_t i = 1; i < fmt_list->viewFormatCount; i++) {
+      VkFormat vk_format = fmt_list->pViewFormats[i];
+      if (vk_format_is_depth_or_stencil(vk_format) ||
+          vk_format_is_compressed(vk_format) ||
+          vk_format_get_plane_count(vk_format) > 1)
+         return false;
+
+      const struct util_format_description *desc =
+         util_format_description(vk_format_to_pipe_format(vk_format));
+
+      if (desc->nr_channels != first->nr_channels ||
+          desc->block.bits != first->block.bits ||
+          desc->block.width != first->block.width ||
+          desc->block.height != first->block.height)
+         return false;
+   }
+
+   return true;
+}
