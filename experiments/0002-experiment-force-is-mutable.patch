diff --git a/src/freedreno/vulkan/tu_image.cc b/src/freedreno/vulkan/tu_image.cc
--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -470,6 +470,17 @@
    bool ubwc_enabled = true;
    bool force_linear_tile = false;
    bool is_mutable = false;
+   /* EXPERIMENT C - NOT FOR COMMIT. Forces the MUTABLEEN bit on for every
+    * MUTABLE_FORMAT non-depth image, *including* lists that 0006 made
+    * UBWC-compatible. Upstream only ever sets is_mutable inside the
+    * `!ubwc_compatible` branch, so probe T (BGRA8/BGRA8_UINT) normally runs
+    * with UBWC on and MUTABLEEN off. Setting it here holds the format pair
+    * constant and toggles only the MUTABLEEN bit, which separates
+    * "MUTABLEEN is broken on gen2" from "that format pair is special".
+    */
+   if ((pCreateInfo->flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) &&
+       !vk_format_is_depth_or_stencil(pCreateInfo->format))
+      is_mutable = true;
    /* Force to either use tiled layout or linear for all mip layers. */
    bool force_disable_linear_fallback = false;
 
