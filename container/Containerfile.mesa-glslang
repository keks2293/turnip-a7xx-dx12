# glslang is needed by meson at configure time: without it `meson setup`
# aborts (meson.build:740 looks for glslangValidator). The package name in Fedora 44
# is glslang, not glslang-tools; glslang-tools is absent from the repository, and
# the install fails with "No match for argument".
#
# The base image — the same one as scripts/build-turnip.sh, otherwise meson/ninja/gcc
# are missing (as in the old variant on fedora:44 directly).
FROM localhost/mesa-build-fedora44-wsi
RUN dnf -y install glslang && dnf clean all
